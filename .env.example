# 复制为 .env 后按需修改；所有变量都以 DS_ 开头
# 开发期默认用 SQLite，切换 Oracle 时只改 DS_DATABASE_URL，
# 例如：oracle+oracledb://dailyspend:密码@localhost:1521/?service_name=FREEPDB1

DS_SECRET_KEY=change-me-to-a-long-random-string
DS_DATABASE_URL=sqlite:///instance/dailyspend.sqlite3
DS_TIMEZONE=Asia/Shanghai
DS_DEBUG=false
DS_REGISTRATION_ENABLED=true

# 部署到公网时务必改成 true（需要 HTTPS）
DS_SESSION_COOKIE_SECURE=false
DS_SESSION_LIFETIME_DAYS=14
